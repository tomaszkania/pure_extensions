import PureEmbeddings.GroupsMathlib
import PureEmbeddings.Germs
import Mathlib.Order.Filter.Ultrafilter.Basic
import Mathlib.Algebra.Category.Grp.Injective
import Mathlib.Data.Nat.Factorization.Induction

/-! Algebraic compactness for the factors of the supported product. -/
namespace PureEmbeddings.Groups
open Set Filter

/-- A finite group solves arbitrary row-finite, finitely soluble systems.
An ultrafilter chooses a common value for each variable among the finite solutions. -/
theorem finite_group_solves {G E V : Type} [AddCommGroup G] [Finite G]
    (s : Germs.System ℤ G E V) (hs : s.FinitelySoluble) :
    ∃ x, ∀ e, s.Holds x e := by
  classical
  choose y hy using hs
  let p := Ultrafilter.of (atTop : Filter (Finset E))
  choose z hz using fun v => (Ultrafilter.map (fun a => y a v) p).eq_pure_of_finite
  have stable (v : V) : ∀ᶠ a in (p : Filter (Finset E)), y a v = z v := by
    have hm : {z v} ∈ Ultrafilter.map (fun a => y a v) p := by simp [hz v]
    exact Ultrafilter.mem_map.mp hm
  refine ⟨z, fun i => ?_⟩
  have tail : ∀ᶠ a in (p : Filter (Finset E)), {i} ≤ a :=
    Ultrafilter.of_le _ (eventually_ge_atTop _)
  have oneRow : ∀ᶠ a in (p : Filter (Finset E)), s.Holds (y a) i :=
    tail.mono fun a h =>
      hy a i (h (Finset.mem_singleton_self i))
  have rowStable : ∀ᶠ a in (p : Filter (Finset E)), ∀ j, y a (s.var i j) = z (s.var i j) :=
    Filter.eventually_all.mpr (fun j => stable _)
  obtain ⟨a,ha,hj⟩ := (oneRow.and rowStable).exists
  simpa only [Germs.System.Holds, hj] using ha

/-- A primary component of a divisible group is again divisible. Division by p
uses its ambient divisor. For a different prime Bézout's identity gives a
divisor in the subgroup generated by the element itself. -/
private theorem primary_prime_surj {D : Type} [AddCommGroup D] [DivisibleBy D ℕ]
    (p : ℕ) [hp : Fact p.Prime] (q : ℕ) (hq : q.Prime) :
    Function.Surjective (fun y : AddCommGroup.primaryComponent D p => q • y) := by
  intro x
  obtain ⟨k,hk⟩ := exists_addOrderOf_eq_prime_pow_iff.mp x.property
  by_cases he : q = p
  · subst q
    obtain ⟨z,hz⟩ := smul_right_surj_of_divisibleBy D ℕ hp.out.ne_zero x.val
    change p • z = x.val at hz
    have hz' : z ∈ AddCommGroup.primaryComponent D p :=
      exists_addOrderOf_eq_prime_pow_iff.mpr ⟨k+1, by rw [pow_succ, mul_smul, hz, hk]⟩
    exact ⟨⟨z,hz'⟩, Subtype.ext hz⟩
  · let t := p^k
    have hc : q.Coprime t := ((Nat.coprime_primes hq hp.out).mpr he).pow_right k
    have bez : (q : ℤ) * q.gcdA t + (t : ℤ) * q.gcdB t = 1 := by
      rw [← Nat.gcd_eq_gcd_ab, hc.gcd_eq_one]; rfl
    have ht : (t : ℤ) • x = 0 := Subtype.ext (by simpa only [natCast_zsmul] using hk)
    refine ⟨q.gcdA t • x, ?_⟩
    calc
      q • (q.gcdA t • x) = ((q : ℤ) * q.gcdA t) • x := by rw [mul_smul, natCast_zsmul]
      _ = (((q : ℤ) * q.gcdA t) + ((t : ℤ) * q.gcdB t)) • x := by
        rw [add_smul, mul_comm (t : ℤ), mul_smul (q.gcdB t) (t : ℤ), ht, smul_zero, add_zero]
      _ = x := by rw [bez, one_smul]

noncomputable def primaryDivisible (p : ℕ) [Fact p.Prime] :
    DivisibleBy (AddCommGroup.primaryComponent RatModInt p) ℤ := by
  letI : DivisibleBy ℚ ℕ := AddGroup.divisibleByNatOfDivisibleByInt ℚ
  let D := AddCommGroup.primaryComponent RatModInt p
  have all (n : ℕ) : n ≠ 0 → Function.Surjective (fun x : D => n • x) := by
    induction n using induction_on_primes with
    | zero => simp
    | one => exact fun _ x => ⟨x,one_smul _ _⟩
    | prime_mul q n hq ih =>
      intro hn x
      obtain ⟨y,hy⟩ := primary_prime_surj p q hq x
      obtain ⟨z,hz⟩ := ih (right_ne_zero_of_mul hn) y
      change n • z = y at hz
      change q • y = x at hy
      exact ⟨z, by change (q*n) • z = x; rw [mul_smul, hz, hy]⟩
  letI : DivisibleBy D ℕ := divisibleByOfSMulRightSurj D ℕ (fun {n} => all n)
  exact AddGroup.divisibleByIntOfDivisibleByNat D

/-- The Prüfer group is injective as a group, hence pure-injective. -/
theorem primary_pureInjective (p : ℕ) [Fact p.Prime] :
    IsPureInjective (ModuleCat.of ℤ (AddCommGroup.primaryComponent RatModInt p)) := by
  let D := AddCommGroup.primaryComponent RatModInt p
  letI : DivisibleBy D ℤ := primaryDivisible p
  letI : Module.Injective ℤ D := (Module.Baer.of_divisible D).injective
  intro A B i f hi
  letI : Module ℤ A := A.isModule
  letI : Module ℤ B := B.isModule
  obtain ⟨g,hg⟩ := @Module.Injective.out ℤ _ D _ _ _ A B A.isAddCommGroup B.isAddCommGroup A.isModule B.isModule i hi.1 f
  refine ⟨g, ?_⟩
  exact DFunLike.ext _ _ hg

/-- The cyclic groups of prime-power order and the Prüfer groups all solve
arbitrary finitely soluble integer systems. -/
theorem factor_solves (t : FactorIndex) {E V : Type}
    (s : Germs.System ℤ (factor t) E V) (hs : s.FinitelySoluble) :
    ∃ x, ∀ e, s.Holds x e := by
  obtain ⟨⟨p,hp⟩,t⟩ := t
  letI : Fact p.Prime := ⟨hp⟩
  cases t with
  | none => exact Germs.algebraically_compact (primary_pureInjective p) s hs
  | some n =>
    haveI : NeZero (p^(n+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    letI : Finite (factor (⟨p,hp⟩, some n)) := inferInstanceAs (Finite (ZMod (p^(n+1))))
    exact finite_group_solves s hs

end PureEmbeddings.Groups
